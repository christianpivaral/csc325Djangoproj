{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: runserver",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver"],
            "django": true,
            "serverReadyAction": {
                "pattern": "Starting .*development server at (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openIntegratedBrowser"
            }
        }
    ]
}
